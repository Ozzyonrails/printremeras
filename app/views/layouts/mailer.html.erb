<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <style>
      body { font-family: -apple-system, Helvetica, Arial, sans-serif; color: #222; background: #f6f6f6; margin: 0; padding: 24px; }
      .card { background: #fff; max-width: 560px; margin: 0 auto; padding: 28px; border-radius: 12px; }
      .btn { display: inline-block; background: #111; color: #fff !important; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; }
      .muted { color: #777; font-size: 13px; }
      table { border-collapse: collapse; width: 100%; } td { padding: 6px 0; border-bottom: 1px solid #eee; }
      h1 { font-size: 20px; }
      .code { font-size: 26px; letter-spacing: 2px; font-weight: 700; background: #f0f0f0; padding: 12px 18px; border-radius: 8px; display: inline-block; }
    </style>
  </head>
  <body>
    <div class="card">
      <%= yield %>
      <p class="muted"><%= Setting.store_name %></p>
    </div>
  </body>
</html>
