<%= form_with model: [ :admin, item ], html: { multipart: true } do |f| %>
  <% if item.errors.any? %><div class="flash flash-alert"><%= item.errors.full_messages.join(", ") %></div><% end %>
  <div class="fields-row">
    <div class="field">
      <%= f.label :template_id, t("admin.catalog.template") %>
      <% if @templates.any? %>
        <%= f.collection_select :template_id, @templates, :id, ->(t) { "#{t.name} · #{t.color_name}" }, {}, class: "input" %>
        <div class="hint"><%= t("admin.catalog.template_hint") %></div>
      <% else %>
        <div class="flash flash-alert" style="margin:0">
          <%= t("admin.catalog.no_templates") %> <%= link_to t("admin.templates.new"), new_admin_template_path %>
        </div>
      <% end %>
    </div>
    <div class="field"><%= f.label :price_cents, t("admin.catalog.price") %><%= f.number_field :price_cents, class: "input", min: 0 %><div class="hint"><%= t("admin.cents_hint") %></div></div>
  </div>
  <% loc = I18n.default_locale.to_s %>
  <div class="field">
    <%= label_tag "catalog_item_title_translations_#{loc}", t("admin.catalog.title") %>
    <%= text_field_tag "catalog_item[title_translations][#{loc}]", item.title_translations[loc], class: "input", id: "catalog_item_title_translations_#{loc}" %>
  </div>
  <div class="field">
    <%= label_tag "catalog_item_description_translations_#{loc}", t("admin.templates.description") %>
    <%= text_area_tag "catalog_item[description_translations][#{loc}]", item.description_translations[loc], class: "input", rows: 2, id: "catalog_item_description_translations_#{loc}" %>
  </div>
  <% if item.new_record? %>
    <div class="field">
      <%= label_tag :design_file, t("admin.catalog.design_file") %>
      <%= file_field_tag :design_file, accept: "image/png,image/jpeg,image/webp", class: "input", required: true %>
      <div class="hint"><%= t("admin.catalog.design_file_hint") %></div>
    </div>
  <% end %>
  <div class="field"><%= label_tag "catalog_item_tags_string", "Tags" %><%= text_field_tag "catalog_item[tags_string]", item.tags.join(", "), class: "input", id: "catalog_item_tags_string", placeholder: "rock, verano, minimal" %></div>
  <%= f.submit t("admin.save"), class: "btn btn-primary" %>
<% end %>
