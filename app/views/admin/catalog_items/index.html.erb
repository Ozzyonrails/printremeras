<% content_for(:title) { t("admin.nav.catalog") } %>
<div class="page-head"><h1><%= t("admin.nav.catalog") %></h1><%= link_to t("admin.catalog.new"), new_admin_catalog_item_path, class: "btn btn-primary" %></div>
<div class="table-wrap"><table class="list">
  <thead><tr><th></th><th><%= t("admin.catalog.title") %></th><th><%= t("admin.templates.name") %></th><th class="num"><%= t("admin.catalog.price") %></th><th>Tags</th><th></th><th></th></tr></thead>
  <tbody>
  <% @items.each do |item| %>
    <tr>
      <td><%= image_or_placeholder(item.preview, :card, class: "thumb", alt: "") %></td>
      <td><%= link_to item.title, editor_admin_catalog_item_path(item) %><div class="small muted"><%= item.slug %></div></td>
      <td><%= item.template.name %></td>
      <td class="num"><%= money(item.price_cents) %></td>
      <td class="small"><%= item.tags.join(", ") %></td>
      <td><% if item.published? %><span class="badge badge-delivered"><%= t("admin.catalog.published") %></span><% else %><span class="badge"><%= t("admin.catalog.draft") %></span><% end %></td>
      <td class="btn-row"><%= link_to t("admin.edit"), edit_admin_catalog_item_path(item), class: "btn btn-sm" %><%= link_to t("admin.catalog.editor"), editor_admin_catalog_item_path(item), class: "btn btn-sm" %></td>
    </tr>
  <% end %>
  </tbody>
</table></div>
