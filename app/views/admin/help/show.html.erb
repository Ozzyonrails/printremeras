    <li><%= t("admin.help.flow_1") %> <%= link_to t("admin.templates.new"), new_admin_template_path %></li>
    <li><%= t("admin.help.flow_2") %></li>
    <li><%= t("admin.help.flow_3") %></li>
    <li><%= t("admin.help.flow_4") %> <%= link_to t("admin.catalog.new"), new_admin_catalog_item_path %></li>
    <li><%= t("admin.help.flow_5") %></li>
