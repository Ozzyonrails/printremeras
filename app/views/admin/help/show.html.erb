<% content_for(:title) { t("admin.nav.help") } %>
<h1><%= t("admin.nav.help") %></h1>

<div class="panel" style="max-width:760px">
  <h2><%= t("admin.help.template_title") %></h2>
  <p><%= t("admin.help.template_body") %></p>
