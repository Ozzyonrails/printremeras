    <li><%= t("admin.help.template_photo") %></li>
    <li><%= t("admin.help.template_area") %></li>
    <li><%= t("admin.help.template_sizes") %></li>
    <li><%= t("admin.help.template_prices") %></li>
  </ul>

  <h2><%= t("admin.help.product_title") %></h2>
