<% content_for(:title) { @template.name } %>
<% content_for(:head) { vite_admin_tags } %>
<div class="page-head">
  <h1><%= @template.name %> <% if @template.active? %><span class="badge badge-delivered"><%= t("admin.active") %></span><% else %><span class="badge"><%= t("admin.inactive") %></span><% end %></h1>
  <div class="btn-row">
    <%= link_to t("admin.edit"), edit_admin_template_path(@template), class: "btn" %>
    <%= link_to t("admin.catalog.new_from_template"), new_admin_catalog_item_path(template_id: @template.id), class: "btn" %>
    <%= button_to t("admin.delete"), admin_template_path(@template), method: :delete, class: "btn btn-danger", form_class: "inline", form: { onsubmit: "return confirm('#{t('admin.confirm')}')" } %>
  </div>
</div>
<div class="panel">
  <dl class="kv">
    <dt><%= t("admin.templates.kind") %></dt><dd><%= @template.kind %> · <span class="color-dot" style="background:<%= @template.color_hex %>"></span><%= @template.color_name %></dd>
    <dt><%= t("admin.templates.pricing") %></dt><dd><%= money(@template.base_price_cents) %> + <%= money(@template.print_price_one_side_cents) %> / <%= money(@template.print_price_two_sides_cents) %> (<%= t("admin.templates.sides_hint") %>)</dd>
  </dl>
  <% unless @template.ready_for_sale? %><p class="warn-text"><%= t("admin.templates.not_ready_hint") %></p><% end %>
</div>

<h2><%= t("admin.templates.print_areas") %></h2>
<% @print_areas.each do |area| %>
  <div class="panel" id="area-<%= area.side %>">
    <h3><%= t("admin.templates.side_#{area.side}") %></h3>
    <%= form_with model: area, url: (area.persisted? ? admin_template_print_area_path(@template, area) : admin_template_print_areas_path(@template)), method: (area.persisted? ? :patch : :post), multipart: true do |f| %>
      <%= f.hidden_field :side %>
      <div class="area-card">
        <div class="area-form">
          <div class="field"><%= f.label :mockup, t("admin.templates.mockup") %><%= f.file_field :mockup, accept: "image/png,image/jpeg,image/webp", class: "input" %><div class="hint"><%= t("admin.templates.mockup_hint") %></div></div>
          <div class="fields-row">
            <div class="field"><%= f.label :width_mm, t("admin.templates.width_mm") %><%= f.number_field :width_mm, step: 0.1, class: "input" %></div>
            <div class="field"><%= f.label :height_mm, t("admin.templates.height_mm") %><%= f.number_field :height_mm, step: 0.1, class: "input" %></div>
          </div>
          <div class="hint"><%= t("admin.templates.size_hint") %></div>
          <%# The rectangle is dragged on the photo; these carry its position and are never typed. %>
          <%= f.hidden_field :x %><%= f.hidden_field :y %><%= f.hidden_field :w %><%= f.hidden_field :h %>
          <%= f.hidden_field :min_dpi %>
          <% if area.aspect_mismatch? %><p class="warn-text"><%= t("admin.templates.aspect_warning_plain") %></p><% end %>
          <div class="btn-row" style="margin-top:10px">
            <%= f.submit t("admin.save"), class: "btn btn-primary" %>
            <% if area.persisted? %><%= button_to t("admin.delete"), admin_template_print_area_path(@template, area), method: :delete, class: "btn btn-danger btn-sm", form_class: "inline", form: { onsubmit: "return confirm('#{t('admin.confirm')}')" } %><% end %>
          </div>
        </div>
        <div class="area-editor">
          <% if area.mockup.attached? && !area.mockup_available? %>
            <div class="flash flash-alert"><%= t("admin.templates.mockup_missing") %></div>
          <% elsif area.mockup.attached? %>
            <div data-react="print-area-editor" data-props="<%= { mockupUrl: rails_representation_path(area.mockup.variant(:editor)), area: { x: area.x.to_f, y: area.y.to_f, w: area.w.to_f, h: area.h.to_f, width_mm: area.width_mm.to_f, height_mm: area.height_mm.to_f }, fieldPrefix: "print_area" }.to_json %>">
              <%= image_tag rails_representation_path(area.mockup.variant(:editor)), style: "max-width:100%", alt: "" %>
              <p class="muted small"><%= t("admin.templates.editor_loading") %></p>
            </div>
          <% else %><p class="muted"><%= t("admin.templates.upload_first") %></p><% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<h2 id="sizes"><%= t("admin.templates.sizes") %></h2>
<div class="panel">
  <div class="table-wrap"><table class="list">
    <thead><tr><th><%= t("admin.templates.size_label") %></th><th><%= t("admin.templates.stock") %></th><th><%= t("admin.templates.restock_at") %></th><th><%= t("admin.position") %></th><th></th></tr></thead>
    <tbody>
    <% @sizes.each do |size| %>
      <tr>
        <%= form_with model: size, url: admin_template_template_size_path(@template, size), method: :patch, id: "size-#{size.id}" do |f| %>
          <td><%= f.text_field :label, class: "input", style: "width:80px" %></td>
          <td><%= f.number_field :stock, class: "input", style: "width:100px", min: 0 %></td>
          <td><%= f.date_field :restock_at, class: "input", style: "width:160px" %></td>
          <td><%= f.number_field :position, class: "input", style: "width:70px" %></td>
          <td class="btn-row"><%= f.submit t("admin.save"), class: "btn btn-sm" %></td>
        <% end %>
      </tr>
      <tr><td colspan="5" style="padding:0 12px 8px"><%= button_to t("admin.delete"), admin_template_template_size_path(@template, size), method: :delete, class: "btn btn-sm btn-danger", form_class: "inline" %></td></tr>
    <% end %>
    <tr>
      <%= form_with model: ::TemplateSize.new, url: admin_template_template_sizes_path(@template), method: :post do |f| %>
        <td><%= f.text_field :label, class: "input", style: "width:80px", placeholder: "XL" %></td>
        <td><%= f.number_field :stock, class: "input", style: "width:100px", min: 0, value: 0 %></td>
        <td><%= f.date_field :restock_at, class: "input", style: "width:160px" %></td>
        <td><%= f.number_field :position, class: "input", style: "width:70px", value: @sizes.size %></td>
        <td><%= f.submit t("admin.templates.add_size"), class: "btn btn-sm btn-primary" %></td>
      <% end %>
    </tr>
    </tbody>
  </table></div>
</div>
