#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing gems =="
  system("bundle check") || system!("bundle install")

  puts "\n== Installing frontend packages =="
  system!("cd frontend && npm install --no-audit --no-fund")

  puts "\n== Preparing .env =="
  FileUtils.cp ".env.example", ".env" unless File.exist?(".env")
  unless File.exist?(".env.development")
    File.write(".env.development", <<~ENV)
      # Development overrides. dotenv loads this before .env, so these win locally while
      # .env stays the file Docker Compose ships to the containers.
      # Not read by Docker Compose (its env_file is .env).

      # The Vite dev server is the entry point in development and proxies /api, /admin,
      # /dev and /cable to Rails, so generated links land on real pages.
      APP_HOST=localhost:5173
      APP_PROTOCOL=http

      STORAGE_BACKEND=local
      PAYMENTS_GATEWAY=Payments::FakeGateway
    ENV
  end
  puts "   .env holds deployment values; .env.development overrides them locally."

  puts "\n== Preparing databases (primary, cache, queue, cable) =="
  system! "bin/rails db:prepare"

  puts "\n== Seeding admin user + demo garments =="
  system! "bin/rails db:seed"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server (Rails :3000, Vite :5173, jobs) =="
    STDOUT.flush
    exec "bin/dev"
  end
end
