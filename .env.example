# ---------------------------------------------------------------------------
# Printremeras — environment configuration. Copy to .env (never commit .env).
# Development reads this via dotenv; Docker Compose via env_file.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
APP_NAME=Printremeras
# Public host (no scheme). Used for links in emails, payment return URLs and host authorization.
APP_HOST=localhost:3000
APP_PROTOCOL=http
# Production only: Thruster obtains a Let's Encrypt cert for this domain (ports 80/443 open).
# TLS_DOMAIN=shop.example.com
# Set to "false" when running behind a proxy that terminates TLS and you don't want redirects.
# FORCE_SSL=true
# ASSUME_SSL=true

# --- Secrets ---------------------------------------------------------------
# Production: generate with `bin/rails secret`. Development uses config/master.key.
# SECRET_KEY_BASE=
# Alternative to SECRET_KEY_BASE if you use config/credentials.yml.enc:
# RAILS_MASTER_KEY=

# --- Database --------------------------------------------------------------
# Development (local Postgres): leave DATABASE_URL unset; the app uses
#   printremeras_development{,_cache,_queue,_cable} on localhost.
# DATABASE_HOST=localhost
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# Production / Docker: the compose file builds DATABASE_URL from these:
POSTGRES_USER=printremeras
POSTGRES_PASSWORD=change-me
POSTGRES_DB=printremeras
# Or set DATABASE_URL directly (cache/queue/cable DBs default to <db>_cache etc.):
# DATABASE_URL=postgres://user:pass@host:5432/printremeras

# --- Object storage (Cloudflare R2 recommended; any S3-compatible works) -----
# local  = disk under storage/ (development, or a Docker volume)
# s3     = two buckets (public + private) via the S3 API
STORAGE_BACKEND=local
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BUCKET=printremeras-public
# S3_PRIVATE_BUCKET=printremeras-private
# S3_FORCE_PATH_STYLE=true
# R2's API endpoint never serves objects anonymously, so images from the public bucket are
# delivered through signed URLs unless the bucket has its own public address. Enable the
# bucket's r2.dev URL (or attach a custom domain) and put it here to serve them straight
# from the CDN instead:
# S3_PUBLIC_BASE_URL=https://pub-<id>.r2.dev

# --- Artwork quality / upscaling -------------------------------------------
# Low-resolution artwork is never rejected: it is accepted, marked in
# Admin -> Calidad de arte, and can be sent to an upscaling service.
# NullProvider only marks it. LocalUpscaleProvider is a libvips resize (adds no
# detail, useful for testing). Point this at a paid provider adapter when you have one.
IMAGE_ENHANCEMENT_PROVIDER=ImageEnhancement::NullProvider

# --- Payments --------------------------------------------------------------
# Payments::FakeGateway (default outside production) or Payments::MercadoPagoGateway.
# The fake gateway's simulator page marks orders paid without money moving, so it is
# blocked in production unless ALLOW_FAKE_PAYMENTS=true — only ever set that on a
# private staging deployment, never on a site customers can reach.
PAYMENTS_GATEWAY=Payments::FakeGateway
# ALLOW_FAKE_PAYMENTS=true
# MercadoPago credentials can also be entered in Admin → Settings (stored in DB).
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# MERCADOPAGO_WEBHOOK_SECRET=

# --- Google OAuth (optional; login button appears only when set) -------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Email -----------------------------------------------------------------
MAIL_FROM=no-reply@example.com
OPERATOR_EMAIL=ops@example.com
# Development without SMTP_ADDRESS opens mails in the browser (letter_opener).
# SMTP_ADDRESS=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_DOMAIN=example.com
# SMTP_AUTHENTICATION=plain

# --- Demo sign-in shortcuts --------------------------------------------------
# The login screens list the seeded demo accounts and fill the form on tap. On by
# default in development. Set this to true to also show them in a production-mode
# container (the docker compose stack) while demoing — the screens then carry a
# visible warning. NEVER leave it on for a publicly reachable deployment.
# SHOW_DEV_CREDENTIALS=true
# Always wins, switches the shortcuts off everywhere:
# HIDE_DEV_CREDENTIALS=true

# --- Seeds (first boot creates this admin) -----------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-1
# Also create demo garments (always on in development).
# SEED_DEMO=true

# --- Tuning ----------------------------------------------------------------
RAILS_MAX_THREADS=3
# Puma workers (clustered mode). Ignored in development, which always runs single mode.
WEB_CONCURRENCY=1
JOB_CONCURRENCY=1
RAILS_LOG_LEVEL=info
# Run jobs inside the web process instead of a separate worker container.
# SOLID_QUEUE_IN_PUMA=true
# Frontend dev server origin (CORS) when it is not proxied through Vite:
# FRONTEND_ORIGIN=http://localhost:5173
